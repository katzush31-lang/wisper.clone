{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wisper-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wisper",
      "database_id": "6e1cd762-f510-49e3-8235-835156ea314d",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "vars": {
    // CI overrides this with the real value (wrangler deploy --var GOOGLE_CLIENT_ID:...).
    "GOOGLE_CLIENT_ID": "REPLACE_ME.apps.googleusercontent.com"
  }
}
